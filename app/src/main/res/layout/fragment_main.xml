<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#EDE2D0"
    tools:context="com.example.diaryofthattime.ui.main.MainFragment">

    <!-- 앱 타이틀 -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="그때의 나"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- 안내 문구 -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="오늘의 감정을 기록해보세요"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <!-- 월 표시 (텍스트만, 실제 달력은 시스템 날짜 기준) -->
    <TextView
        android:id="@+id/txtMonth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="이번 달"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- 출석 / 감정 기록 현황 영역 -->
    <FrameLayout
        android:id="@+id/layoutAttendance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_attendance_box"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <!-- 실제 달력 -->
        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:theme="@style/CustomCalendarTheme"
            android:showWeekNumber="false"
            android:firstDayOfWeek="1"
            />

        <!-- 출석 상태 표시 (나중에 이미지로 교체 예정) -->
        <TextView
            android:id="@+id/txtAttendanceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="날짜를 선택하세요"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 감정 기록 버튼 -->
    <Button
        android:id="@+id/btnWriteEmotion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#9B7F61"
        android:text="감정 기록하기" />

    <!-- 감정 보관함 버튼 -->
    <Button
        android:id="@+id/btnArchive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="감정 보관함"
        android:backgroundTint="#9B7F61"
        android:layout_marginTop="8dp" />

</LinearLayout>
